# Yerel demo yapılandırması. Değerler sahte/örnektir; gerçek ortamda hepsini değiştirin.
# cp .env.example .env && docker compose up --build

# PostgreSQL (veritabanı host'a açılmaz). Parola URL içinde kullanıldığı için harf/rakam/-/_ tercih edin.
POSTGRES_USER=guvenpolice
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=guvenpolice

# JWT imza anahtarı: en az 32 bayt rastgele değer (ör. openssl rand -hex 32)
JWT_SECRET=change-me-this-is-not-a-real-secret-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# HTTPS arkasında true olmalı (localhost demo için false)
COOKIE_SECURE=false

# Demo seed: 6 rol hesabı bu parola ile oluşturulur (bcrypt ile saklanır)
SEED_DEMO=true
DEMO_PASSWORD=Demo-Parola-2026

# Bu tutarı (kuruş) aşan teklif underwriter onayına düşer; 0 = kural kapalı (örnek değer)
UW_PREMIUM_THRESHOLD_KURUS=3000000
# IN_PROGRESS kalmış Idempotency-Key bu süreden sonra yeniden işlenebilir
IDEMPOTENCY_STALE_AFTER=60s

LOG_LEVEL=info

# Kurgusal basit günlük faiz: 1000 ppm = %0,1
LATE_INTEREST_DAILY_PPM=1000

# Kurgusal danışma amaçlı fraud kuralları ve takvim saati SLA süreleri
FRAUD_THRESHOLD=60
FRAUD_EARLY_DAYS=15
FRAUD_EARLY_POINTS=40
FRAUD_REPEAT_DAYS=365
FRAUD_REPEAT_MINIMUM=2
FRAUD_REPEAT_POINTS=35
FRAUD_WORKSHOP_DAYS=30
FRAUD_WORKSHOP_MINIMUM=4
FRAUD_WORKSHOP_POINTS=30
SLA_APPRAISAL=72h
SLA_ADJUSTMENT=48h
SLA_FRAUD_REVIEW=24h
